        {
          "name": "Crear usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);",
                  "pm.test(\"Devuelve el usuario creado\", () => { const d = pm.response.json(); pm.expect(d.nombre === 'Carlos Ruiz').to.be.true; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Ruiz\",\n  \"email\": \"carlos{{$timestamp}}@correo.com\",\n  \"telefono\": \"3007778899\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Listar usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
